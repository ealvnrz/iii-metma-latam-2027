---
import PageHero from '../components/PageHero.astro';
import SitePageLayout from '../layouts/SitePageLayout.astro';
import { site } from '../data/site';

const title = 'Registration | III METMA LATAM 2027';
const description = 'Forthcoming registration information for III METMA LATAM 2027.';
const page = site.futurePages.registration;
---

<SitePageLayout title={title} description={description} noindex={true}>
  <PageHero
    eyebrow="Attend the conference"
    heading="Registration"
    lead="Registration details are being prepared. This route can be activated in the main navigation as soon as categories, fees and policies are approved."
  />

  <section class="detail-section detail-section-paper" aria-labelledby="registration-status-title">
    <div class="container release-grid">
      <div>
        <p class="release-status">{page.status}</p>
        <h2 id="registration-status-title">Information to be confirmed</h2>
      </div>
      <ol class="release-list">
        {page.items.map((item, index) => (
          <li><span>{String(index + 1).padStart(2, '0')}</span><p>{item}</p></li>
        ))}
      </ol>
    </div>
  </section>

  <section class="detail-section" aria-labelledby="registration-next-title">
    <div class="container detail-grid">
      <div><p class="eyebrow">Publication status</p><h2 id="registration-next-title">Registration will open later</h2></div>
      <p class="status-note">No registration form or payment link is active. Confirmed information will be published here before registration opens.</p>
    </div>
  </section>
</SitePageLayout>
