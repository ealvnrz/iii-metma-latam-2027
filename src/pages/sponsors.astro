---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import SectionHeading from "../components/SectionHeading.astro";
import SponsorGrid from "../components/SponsorGrid.astro";
import { sponsorGroups } from "../data/sponsors";
---

<BaseLayout
  title="Sponsors"
  description="Sponsors and institutional partners for III METMA LATAM 2027."
>
  <Hero
    title="Sponsors and Institutional Partners"
    subtitle="Host, academic partner, sponsor, and supporting society information will be updated as confirmations are available."
  />

  <section class="section">
    <div class="container">
      <SectionHeading
        eyebrow="Partnerships"
        title="Support for III METMA LATAM 2027"
        lede="This page is structured for confirmed institutional and sponsor information. Placeholder cards remain clearly marked until formal confirmations are available."
        align="center"
      />
      <SponsorGrid groups={sponsorGroups} />
    </div>
  </section>
</BaseLayout>
