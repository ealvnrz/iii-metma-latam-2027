---
import BaseLayout from '../layouts/BaseLayout.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import KeynoteSpeakers from '../components/KeynoteSpeakers.astro';
import OrganizersSection from '../components/OrganizersSection.astro';
import ProgrammeSnapshot from '../components/ProgrammeSnapshot.astro';
import SectionHeading from '../components/SectionHeading.astro';
import VenueTeaser from '../components/VenueTeaser.astro';

const title = 'III METMA LATAM 2027 | Santiago, Chile';
const description = 'III METMA LATAM 2027, the Latin American Conference on Spatio-Temporal Modelling, will take place in Santiago, Chile, from 1–3 September 2027.';
---

<BaseLayout title={title} description={description}>
  <Header />
  <main id="main-content">
    <Hero />
    <KeynoteSpeakers />

    <section class="section about" id="about" aria-labelledby="about-title">
      <div class="container split-section">
        <SectionHeading
          label="About the meeting"
          heading="A meeting point for spatio-temporal statistical science in Latin America"
          headingId="about-title"
        />
        <div class="body-copy">
          <p>III METMA LATAM 2027 brings together researchers, practitioners and students working on spatial, temporal and spatio-temporal statistical modelling. The meeting provides a focused forum for methodological developments, computational advances and applications across Latin America and beyond.</p>
          <p>The 2027 edition will take place in Santiago, Chile, at Pontificia Universidad Católica de Chile.</p>
        </div>
      </div>
    </section>

    <ProgrammeSnapshot />

    <VenueTeaser />
    <OrganizersSection />
  </main>
  <Footer />
</BaseLayout>
