---
import Countdown from './Countdown.astro';
---

<section class="hero" id="top" aria-labelledby="hero-title">
  <div class="container hero-masthead">
    <div class="hero-brand">
      <img
        class="hero-logo"
        src="/assets/brand/metma-latam-2027-master-transparent.png"
        alt="III METMA LATAM 2027"
        width="1559"
        height="941"
      />
    </div>

    <div class="hero-masthead-copy">
      <h1 id="hero-title">Latin American Conference on<span class="hero-title-line"> Spatio-Temporal Modelling</span></h1>
      <div class="hero-masthead-meta" aria-label="1 to 3 September 2027, Santiago, Chile">
        <p class="hero-masthead-days">01—03</p>
        <p>September<br /><strong>2027</strong></p>
        <p>Santiago<br /><strong>Chile</strong></p>
      </div>
      <a class="text-link hero-speakers-link" href="#speakers">Meet the keynote speakers <span aria-hidden="true">↓</span></a>
    </div>
  </div>

  <div class="hero-visual" aria-hidden="true">
    <img
      class="hero-photo"
      src="https://images.unsplash.com/photo-1689850543263-01a52ccc6943?auto=format&fit=crop&fm=jpg&q=88&w=2000"
      srcset="https://images.unsplash.com/photo-1689850543263-01a52ccc6943?auto=format&fit=crop&fm=jpg&q=86&w=1200 1200w, https://images.unsplash.com/photo-1689850543263-01a52ccc6943?auto=format&fit=crop&fm=jpg&q=88&w=2000 2000w, https://images.unsplash.com/photo-1689850543263-01a52ccc6943?auto=format&fit=crop&fm=jpg&q=88&w=3200 3200w, https://images.unsplash.com/photo-1689850543263-01a52ccc6943?auto=format&fit=crop&fm=jpg&q=88&w=4800 4800w"
      sizes="100vw"
      alt=""
      width="3200"
      height="2135"
      fetchpriority="high"
    />
  </div>

  <div class="container hero-countdown" id="dates">
    <Countdown />
  </div>
</section>
