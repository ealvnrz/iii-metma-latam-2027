---
import PageHero from '../components/PageHero.astro';
import VenueSection from '../components/VenueSection.astro';
import SitePageLayout from '../layouts/SitePageLayout.astro';
import { site } from '../data/site';

const title = 'Venue & Travel | III METMA LATAM 2027';
const description = 'Venue, travel and accommodation information for III METMA LATAM 2027 in Santiago, Chile.';
---

<SitePageLayout title={title} description={description}>
  <PageHero
    eyebrow="Plan your visit"
    heading="Venue & travel"
    lead={`The meeting will be held at the ${site.venue.name}, ${site.venue.institution}, in Santiago.`}
  />

  <VenueSection showPageLink={false} />

  <section class="detail-section visitor-information" aria-labelledby="visitor-information-title">
    <div class="container">
      <div class="visitor-intro">
        <div>
          <p class="eyebrow">Plan your journey</p>
          <h2 id="visitor-information-title">Practical information</h2>
        </div>
        <p>Travel guidance was reviewed on {site.visitorInformation.verifiedOn}. Details that depend on the final 2027 arrangements are clearly marked and will be updated before the meeting.</p>
      </div>

      <div class="visitor-card-grid">
        {site.visitorInformation.sections.map((section, index) => (
          <article class="visitor-card" id={section.id}>
            <div class="visitor-card-topline">
              <span>{String(index + 1).padStart(2, '0')}</span>
              <span class:list={['information-status', { 'information-status-pending': section.status === 'Details forthcoming' }]}>{section.status}</span>
            </div>
            <p class="eyebrow">{section.eyebrow}</p>
            <h3>{section.title}</h3>
            <p>{section.description}</p>
            <div class="visitor-links">
              {section.links.map((link) => (
                <a class="text-link" href={link.url} target="_blank" rel="noreferrer">
                  {link.label} <span aria-hidden="true">↗</span>
                </a>
              ))}
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
</SitePageLayout>
