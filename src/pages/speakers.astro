---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import SectionHeading from "../components/SectionHeading.astro";
import SpeakerCard from "../components/SpeakerCard.astro";
import { speakers } from "../data/speakers";
---

<BaseLayout
  title="Speakers"
  description="Invited speaker information for III METMA LATAM 2027."
>
  <Hero
    title="Invited Speakers"
    subtitle="Confirmed invited speakers, affiliations, and lecture topics will be announced."
  />

  <section class="section">
    <div class="container">
      <SectionHeading
        eyebrow="To Be Announced"
        title="Speaker announcements"
        lede="This section is structured so confirmed speakers can be added without changing the page layout."
        align="center"
      />
      <div class="speaker-grid">
        {speakers.map((speaker) => <SpeakerCard speaker={speaker} />)}
      </div>
    </div>
  </section>
</BaseLayout>
