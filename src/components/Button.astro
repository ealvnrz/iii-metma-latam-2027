---
type Variant = "primary" | "secondary" | "ghost";

type Props = {
  href: string;
  variant?: Variant;
  target?: string;
  rel?: string;
  class?: string;
};

const { href, variant = "primary", target, rel, class: className = "" } = Astro.props;
const computedRel = rel ?? (target === "_blank" ? "noreferrer" : undefined);
---

<a class:list={["button", `button--${variant}`, className]} href={href} target={target} rel={computedRel}>
  <slot />
</a>
