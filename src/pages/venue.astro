---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import SectionHeading from "../components/SectionHeading.astro";
---

<BaseLayout
  title="Venue"
  description="Venue and travel information for III METMA LATAM 2027 in Santiago, Chile."
>
  <Hero
    title="Venue"
    subtitle="Santiago, Chile, is indicated in the official conference poster as the host city."
    location="Santiago, Chile"
    date="1-3 September 2027"
    venue="Pontificia Universidad Catolica de Chile"
  />

  <section class="section section--map">
    <div class="container venue-map">
      <SectionHeading
        eyebrow="Location"
        title="Faculty of Mathematics, UC, Chile"
        lede="The map pin indicates the Faculty of Mathematics at Pontificia Universidad Catolica de Chile in Santiago. Final room and campus access details will be announced."
        align="center"
      />
      <div class="map-panel">
        <iframe
          title="Map pin for Facultad de Matematicas, Pontificia Universidad Catolica de Chile"
          src="https://maps.google.com/maps?q=-33.498669,-70.6106848864301&z=17&output=embed"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          allowfullscreen
        ></iframe>
        <a
          class="map-panel__link"
          href="https://www.google.com/maps?q=-33.498669,-70.6106848864301"
          target="_blank"
          rel="noreferrer"
        >
          Open pinned location in Google Maps
        </a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container content-grid">
      <article class="content-block">
        <SectionHeading eyebrow="Host City" title="Santiago, Chile" />
        <p>
          Santiago sits between the Andes and Chile's central valley, offering a
          distinctive urban and geographic setting for a conference on spatial
          and spatio-temporal modelling.
        </p>
      </article>

      <article class="content-block">
        <SectionHeading eyebrow="Conference Venue" title="Pontificia Universidad Catolica de Chile" />
        <p>
          The official poster indicates Pontificia Universidad Catolica de Chile
          as the conference venue. Specific campus, building, and room details
          are to be announced.
        </p>
      </article>

      <article class="content-block">
        <SectionHeading eyebrow="Travel Information" title="Arrival guidance to be announced" />
        <p>
          Travel guidance, recommended arrival airports, visa notes, and local
          orientation will be added after the local organization confirms the
          official instructions.
        </p>
      </article>

      <article class="content-block">
        <SectionHeading eyebrow="Local Transportation" title="Transport details to be announced" />
        <p>
          Information on public transportation, campus access, taxi or ride-share
          options, and mobility guidance will be published closer to the event.
        </p>
      </article>

      <article class="content-block content-block--wide">
        <SectionHeading eyebrow="Practical Information" title="Useful local notes" />
        <p>
          Practical information about weather, accessibility, internet access,
          local currency, safety, and nearby services will be provided once the
          local arrangements are confirmed.
        </p>
      </article>
    </div>
  </section>
</BaseLayout>
