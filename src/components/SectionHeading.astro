---
type Props = {
  eyebrow?: string;
  title: string;
  lede?: string;
  align?: "start" | "center";
};

const { eyebrow, title, lede, align = "start" } = Astro.props;
---

<header class:list={["section-heading", `section-heading--${align}`]}>
  {eyebrow && <p class="eyebrow">{eyebrow}</p>}
  <h2>{title}</h2>
  {lede && <p class="section-heading__lede">{lede}</p>}
</header>
