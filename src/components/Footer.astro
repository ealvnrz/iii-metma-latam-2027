---
import { footerNavigation } from "../data/navigation";
---

<footer class="site-footer">
  <div class="container site-footer__inner">
    <div class="site-footer__brand">
      <img src="/assets/logo-horizontal-footer-transparent.png" alt="III METMA LATAM 2027" loading="lazy" />
      <p>
        Latin American Conference on Spatio-Temporal Modelling, Santiago, Chile,
        1-3 September 2027.
      </p>
    </div>

    <nav class="site-footer__nav" aria-label="Footer navigation">
      {footerNavigation.map((item) => <a href={item.href}>{item.label}</a>)}
    </nav>

    <div class="site-footer__contact">
      <strong>Contact</strong>
      <p>Contact email to be announced</p>
      <p>Submission platform to be announced</p>
    </div>
  </div>
</footer>
