---
import type { ProgrammeDay } from "../data/programme";

type Props = {
  days: ProgrammeDay[];
};

const { days } = Astro.props;
---

<div class="programme-timeline">
  {days.map((day) => (
    <article class="programme-day">
      <div class="programme-day__head">
        <span>{day.day}</span>
        <h3>{day.date}</h3>
        <p>{day.theme}</p>
      </div>
      <ol>
        {day.items.map((item) => (
          <li>
            <time>{item.time}</time>
            <div>
              <strong>{item.title}</strong>
              {item.description && <p>{item.description}</p>}
            </div>
          </li>
        ))}
      </ol>
    </article>
  ))}
</div>
