---
import SectionHeading from './SectionHeading.astro';
---

<section class="section journal-collection" id="journal-collection" aria-labelledby="journal-collection-title">
  <div class="container journal-collection-grid">
    <div class="journal-collection-copy">
      <SectionHeading
        label="Journal collection"
        heading="Environmental and Ecological Statistics"
        headingId="journal-collection-title"
      />
      <p class="journal-collection-description">In association with III METMA LATAM 2027, the journal will publish a collection featuring a selection of papers presented at the conference.</p>
      <a class="section-link" href="https://link.springer.com/journal/10651">Visit the journal <span aria-hidden="true">↗</span></a>
    </div>
    <figure class="journal-collection-cover">
      <img
        src="/assets/journals/environmental-and-ecological-statistics.webp"
        alt="Cover of Environmental and Ecological Statistics"
        width="827"
        height="1256"
        loading="lazy"
        decoding="async"
      />
      <figcaption>Journal cover · Springer</figcaption>
    </figure>
  </div>
</section>
