---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import SectionHeading from "../components/SectionHeading.astro";

const accommodationCards = [
  {
    title: "Recommended hotels",
    text: "Recommended hotels and booking instructions to be announced."
  },
  {
    title: "Venue proximity",
    text: "Guidance on areas convenient for the conference venue to be announced."
  },
  {
    title: "Student options",
    text: "Information about student-friendly accommodation options to be announced."
  },
  {
    title: "Booking notes",
    text: "No conference hotel rates or booking codes have been announced."
  }
];
---

<BaseLayout
  title="Accommodation"
  description="Accommodation information for III METMA LATAM 2027."
>
  <Hero
    title="Accommodation"
    subtitle="Recommended accommodation and booking guidance will be announced."
  />

  <section class="section">
    <div class="container">
      <SectionHeading
        eyebrow="Stay in Santiago"
        title="Accommodation information will be added after venue logistics are confirmed"
        lede="This page is prepared for recommended hotels, campus or venue proximity notes, and booking instructions. No hotel deals are currently listed."
        align="center"
      />
      <div class="cards-4">
        {accommodationCards.map((card) => (
          <article class="info-card">
            <h2>{card.title}</h2>
            <p>{card.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
