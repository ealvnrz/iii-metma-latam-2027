---
import { site } from '../data/site';
---

<section class="hero" id="top" aria-labelledby="hero-title">
  <div class="container hero-grid">
    <div class="hero-brand">
      <img
        class="hero-logo"
        src="/assets/brand/metma-latam-2027-master-transparent.png"
        alt="III METMA LATAM 2027"
        width="1559"
        height="941"
      />
    </div>

    <div class="hero-copy">
      <h1 id="hero-title">Latin American Conference on<br />Spatio-Temporal Modelling</h1>
      <p class="hero-meta">
        <span>{site.date}</span>
        <i aria-hidden="true"></i>
        <span>{site.location}</span>
      </p>
    </div>

    <div class="date-poster" aria-label="1 to 3 September 2027, Santiago, Chile">
      <p class="date-poster-days">01—03</p>
      <div class="date-poster-details">
        <p>September<br /><strong>2027</strong></p>
        <p>Santiago<br /><strong>Chile</strong></p>
      </div>
    </div>
  </div>
</section>
