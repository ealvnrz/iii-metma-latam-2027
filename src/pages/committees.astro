---
import PageHero from '../components/PageHero.astro';
import PeopleGrid from '../components/PeopleGrid.astro';
import OrganizersSection from '../components/OrganizersSection.astro';
import SitePageLayout from '../layouts/SitePageLayout.astro';
import { site } from '../data/site';

const title = 'Committees | III METMA LATAM 2027';
const description = 'Organizing and scientific committees for III METMA LATAM 2027.';
---

<SitePageLayout title={title} description={description}>
  <PageHero
    eyebrow="Conference organization"
    heading="Committees"
    lead="The organizing and scientific committees bring together the people shaping the 2027 meeting and its scientific programme."
  />

  <section class="detail-section detail-section-paper organizing-committee" id="organizing-committee" aria-labelledby="organizing-committee-title">
    <div class="container detail-grid">
      <div>
        <p class="eyebrow">Conference team</p>
        <h2 id="organizing-committee-title">Organizing committee</h2>
      </div>
      <PeopleGrid people={site.committees.organizing} emptyMessage="The organizing committee is being formed. Names and affiliations will be published here." />
    </div>
  </section>

  <section class="detail-section" aria-labelledby="scientific-committee-title">
    <div class="container detail-grid">
      <div>
        <p class="eyebrow">Scientific direction</p>
        <h2 id="scientific-committee-title">Scientific committee</h2>
      </div>
      <PeopleGrid people={site.committees.scientific} emptyMessage="The scientific committee is being formed. Names and affiliations will be published here." />
    </div>
  </section>

  <OrganizersSection showCommitteeLink={false} />
</SitePageLayout>
