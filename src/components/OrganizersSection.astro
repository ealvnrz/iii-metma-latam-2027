---
import InstitutionGrid from './InstitutionGrid.astro';
import { site } from '../data/site';

interface Props {
  showCommitteeLink?: boolean;
}

const { showCommitteeLink = true } = Astro.props;
---

<section class="section organizers" id="organizers" aria-labelledby="organizers-title">
  <div class="container">
    <div class="institution-group institution-group-organizer">
      <h2 id="organizers-title">Organized by</h2>
      <InstitutionGrid institutions={site.organizers} organizer />
    </div>
    <div class="institution-group" role="group" aria-labelledby="sponsors-title">
      <h2 id="sponsors-title">Supporting institutions</h2>
      <InstitutionGrid institutions={site.sponsors} />
    </div>
    {showCommitteeLink && <a class="section-link" href="/committees">View the committees <span aria-hidden="true">→</span></a>}
  </div>
</section>
