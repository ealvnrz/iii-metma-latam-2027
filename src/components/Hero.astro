---
import Button from "./Button.astro";
import DecorativePattern from "./DecorativePattern.astro";

type Cta = {
  label: string;
  href: string;
  variant?: "primary" | "secondary" | "ghost";
};

type Props = {
  eyebrow?: string;
  title: string;
  subtitle?: string;
  location?: string;
  date?: string;
  venue?: string;
  ctas?: Cta[];
  variant?: "home" | "page";
};

const {
  eyebrow = "III METMA LATAM 2027",
  title,
  subtitle,
  location,
  date,
  venue,
  ctas = [],
  variant = "page"
} = Astro.props;

const mediaSrc = variant === "home"
  ? "/assets/fondo-seccion-red-mapa-transparente.webp"
  : "/assets/fondo-seccion-red-mapa-transparente.webp";
---

<section class:list={["hero", `hero--${variant}`]}>
  <div class="hero__media" aria-hidden="true">
    <img src={mediaSrc} alt="" />
  </div>
  <DecorativePattern variant={variant === "home" ? "dark" : "light"} />

  <div class="container hero__inner">
    <div class="hero__content">
      <p class="eyebrow">{eyebrow}</p>
      <h1>{title}</h1>
      {subtitle && <p class="hero__subtitle">{subtitle}</p>}

      {(location || date || venue) && (
        <dl class="hero__meta">
          {location && (
            <div>
              <dt>Location</dt>
              <dd>{location}</dd>
            </div>
          )}
          {date && (
            <div>
              <dt>Dates</dt>
              <dd>{date}</dd>
            </div>
          )}
          {venue && (
            <div>
              <dt>Venue</dt>
              <dd>{venue}</dd>
            </div>
          )}
        </dl>
      )}

      {ctas.length > 0 && (
        <div class="hero__actions">
          {ctas.map((cta) => (
            <Button href={cta.href} variant={cta.variant ?? "primary"}>{cta.label}</Button>
          ))}
        </div>
      )}
    </div>

    {variant === "home" && (
      <aside class="hero__visual" aria-label="Conference visual identity">
        <div class="hero-poster-card">
          <img src="/assets/afiche_metma_latam.png" alt="Official poster for III METMA LATAM 2027" />
        </div>
      </aside>
    )}
  </div>
</section>
